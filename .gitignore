# Whitelist: de repo is publiek en bevat alleen wat nodig is om de tools te laten werken.
# Alles is genegeerd, behalve wat hieronder met ! terugkomt:
#   - code die bookmarklets/launcher ophalen van raw.githubusercontent.com
#   - pagina's die GitHub Pages serveert (installatie, beheer)
# Documentatie (CLAUDE.md, README.md), build.py, GAS-broncode, loader-bronnen,
# probes en exports blijven lokaal. Nieuwe tool? Zijn .js (en install-pagina) hier toevoegen.

/*
!/.gitignore

# Pagina's (GitHub Pages)
!/index.html
!/install.html
!/handleiding.html
!/tampermonkey.html

# Code geladen door de loaders / launcher
!/ds-logboek.js
!/paste-bookmarklet.js

!/launcher/
/launcher/*
!/launcher/launcher.js
!/launcher/status.json
!/launcher/beheer.html
!/launcher/install-dev.html
!/launcher/ds-tools.user.js
!/launcher/ds-tools-dev.user.js

!/tourtool/
/tourtool/*
!/tourtool/extra-rijtijd.js
!/tourtool/install-rijtijd.html

!/laadvermogen/
/laadvermogen/*
!/laadvermogen/laadvermogen.js
!/laadvermogen/planning-instellingen.js
!/laadvermogen/install-laadvermogen.html
!/laadvermogen/planning-combi.user.js

!/schuifalias/
/schuifalias/*
!/schuifalias/schuifalias.js
!/schuifalias/schuifalias-knop.user.js
!/schuifalias/install-schuifalias.html

!/ev/
/ev/*
!/ev/ev-ritten.js
!/ev/ev-ritten.user.js

!/logboek/
/logboek/*
!/logboek/logboek-portal.user.js
!/logboek/logboek-basic.user.js

!/plakken/
/plakken/*
!/plakken/ds-plakken.user.js

!/opmerking/
/opmerking/*
!/opmerking/opmerking-knoppen.user.js

!/probleem/
/probleem/*
!/probleem/manco-knoppen.user.js

!/sophia/
/sophia/*
!/sophia/sft-autopilot.user.js

!/extern/
/extern/*
!/extern/*.js

# Vangnet: nooit, ook niet binnen een gewhiteliste map
*.local.js
*.har
*.xlsx
